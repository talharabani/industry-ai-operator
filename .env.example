# Industry-Adaptive AI Operator - Environment Configuration
# Copy this file to .env.local and fill in your values.

# n8n Webhook Base URL and Operator Secret Header
N8N_BASE_URL=http://localhost:5678
N8N_OPERATOR_KEY=your_n8n_operator_key_here

# PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# IMPORTANT: If your password contains special characters (like @, :, /, #, $, %, etc.),
# you MUST URL-encode them. (e.g., '@' becomes '%40', '#' becomes '%23')
DATABASE_URL=postgresql://iao_demo:REPLACE_ME@localhost:5433/iao_demo

# Server-Resolved Demo Identities (Never passed from untrusted client requests)
DEMO_TENANT_ID=demo-store
DEMO_APPROVER_ID=owner-demo

# Optional Display Preferences
NEXT_PUBLIC_TIMEZONE=Asia/Karachi

# Social Media AI Content Engine (Groq Llama-3.3-70b)
# Obtain key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Meta App Setup for Facebook Pages API (Live Pilot)
# Register app at https://developers.facebook.com
FACEBOOK_CLIENT_ID=your_meta_app_id
FACEBOOK_CLIENT_SECRET=your_meta_app_secret

