{
  "name": "Industry AI Operator - Shopify Store Scheduled Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Schedule (Every 15 Min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {},
      "id": "node-manual-trigger",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/cron/sync-shopify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "retry": {
            "retry": {
              "maxTries": 3,
              "waitBetweenTries": 5000
            }
          },
          "timeout": 30000
        }
      },
      "id": "node-http-sync-shopify",
      "name": "Trigger Shopify Store Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "iao_operator_key",
          "name": "IAO Operator Header Auth"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-sync-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-success",
      "name": "Check Sync Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract sync summary for reporting\nconst syncResult = $input.first().json;\nconst tenantsCount = syncResult.tenants_count || 0;\nconst successfulCount = syncResult.successful_count || 0;\nconst partialCount = syncResult.partial_count || 0;\nconst results = syncResult.results || {};\n\nconsole.log(`[Shopify Sync Success] Synced ${tenantsCount} stores (${successfulCount} completed, ${partialCount} partial).`);\n\nreturn [{\n  json: {\n    outcome: 'success',\n    synced_at: new Date().toISOString(),\n    tenants_count: tenantsCount,\n    successful_count: successfulCount,\n    partial_count: partialCount,\n    details: results\n  }\n}];"
      },
      "id": "node-sync-success-log",
      "name": "Log Sync Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format failure alert\nconst syncError = $input.first().json;\nconsole.error('[Shopify Sync Failure Alert]', JSON.stringify(syncError));\n\nreturn [{\n  json: {\n    outcome: 'failed',\n    failed_at: new Date().toISOString(),\n    error_payload: syncError,\n    alert_message: `Shopify sync failed: ${syncError.error || syncError.message || 'Unknown error'}`\n  }\n}];"
      },
      "id": "node-sync-failure-alert",
      "name": "Handle Sync Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        460
      ]
    }
  ],
  "connections": {
    "Schedule (Every 15 Min)": {
      "main": [
        [
          {
            "node": "Trigger Shopify Store Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Trigger Shopify Store Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Shopify Store Sync": {
      "main": [
        [
          {
            "node": "Check Sync Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Sync Status": {
      "main": [
        [
          {
            "node": "Log Sync Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Handle Sync Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
